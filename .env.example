# -----------------------------------------------------------------------------
# VÉRTICE AUTOMOTIVE — variáveis de ambiente do frontend
# Copie para .env.local e preencha. Valores abaixo são fictícios.
#
# ATENÇÃO: tudo que começa com VITE_ é embutido no JavaScript público.
# Use SOMENTE a URL do projeto e a chave pública (anon / publishable).
# NUNCA coloque a service_role / secret key em variáveis VITE_.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-ou-publishable

# URL pública final do site (usada em SEO e no link de redefinição de senha)
VITE_SITE_URL=https://www.exemplo.com.br

# -----------------------------------------------------------------------------
# Somente para scripts locais (scripts/create-admin.mjs). Não use no frontend
# e não faça commit deste valor.
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=nao-commitar
